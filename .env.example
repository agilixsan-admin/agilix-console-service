# =============================================================================
# Agilix Console Service — Environment Variables
# =============================================================================
# Copy file ini menjadi .env dan isi sesuai environment.
# Semua variable yang tidak memiliki default value WAJIB diisi.
# Referensi validasi: src/configs/validation.schema.ts
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=localhost
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Database — PostgreSQL
# WAJIB diisi
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=agilix_console
DB_SSL=false
# Pool size TypeORM — kecil karena PgBouncer yang handle pooling ke PostgreSQL
# Untuk konek langsung ke Postgres tanpa PgBouncer, naikkan ke 10-20
DB_POOL_MAX=5

# -----------------------------------------------------------------------------
# JWT
# WAJIB diisi — minimum 32 karakter
# Gunakan: openssl rand -hex 32
# JWT_SECRET         — untuk access token
# JWT_REFRESH_SECRET — untuk refresh token (harus berbeda dari JWT_SECRET)
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Redis
# Digunakan untuk: Token Blacklist, BullMQ Queue (Phase 2)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# SMTP — Email
# Digunakan untuk: Notification Module (Phase 2)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@agilix.id

# -----------------------------------------------------------------------------
# Bcrypt
# Salt rounds: 10-14 (lebih tinggi = lebih aman tapi lebih lambat)
# Rekomendasi production: 12
# -----------------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12

# -----------------------------------------------------------------------------
# Seed
# Digunakan untuk: seeding SUPER_ADMIN pertama kali
# -----------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@agilix.com
SEED_SUPER_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Cron Schedule — Invoice Scheduler
# Format: "MENIT JAM * * *" (cron expression)
# Contoh:
#   "0 8 * * *"  = setiap hari jam 08:00
#   "* * * * *"  = setiap menit (untuk testing)
#   "0 */2 * * *" = setiap 2 jam
# -----------------------------------------------------------------------------
CRON_INVOICE_REMINDER=0 8 * * *
CRON_INVOICE_OVERDUE=0 9 * * *

# -----------------------------------------------------------------------------
# ERP Webhook — Console → ERP
# Console akan push event ke ERP ketika tenant created/locked/unlocked/deleted
# ERP_WEBHOOK_URL     — endpoint ERP yang menerima webhook
# ERP_WEBHOOK_API_KEY — API key untuk autentikasi (header: X-Api-Key)
# ERP_WEBHOOK_TIMEOUT — timeout HTTP call dalam ms (default: 5000)
# -----------------------------------------------------------------------------
ERP_WEBHOOK_URL=
ERP_WEBHOOK_API_KEY=
ERP_WEBHOOK_TIMEOUT=5000

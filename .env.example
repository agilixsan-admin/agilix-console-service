# =============================================================================
# Agilix Console Service — Environment Variables
# =============================================================================
# Copy file ini menjadi .env dan isi sesuai environment.
# Semua variable yang tidak memiliki default value WAJIB diisi.
# Referensi validasi: src/configs/validation.schema.ts
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=localhost
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Database — PostgreSQL
# WAJIB diisi
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=agilix_console
DB_SSL=false

# -----------------------------------------------------------------------------
# JWT
# WAJIB diisi — minimum 32 karakter
# Gunakan: openssl rand -hex 32
# JWT_SECRET         — untuk access token
# JWT_REFRESH_SECRET — untuk refresh token (harus berbeda dari JWT_SECRET)
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Redis
# Digunakan untuk: Token Blacklist, BullMQ Queue (Phase 2)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# SMTP — Email
# Digunakan untuk: Notification Module (Phase 2)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@agilix.id

# -----------------------------------------------------------------------------
# Bcrypt
# Salt rounds: 10-14 (lebih tinggi = lebih aman tapi lebih lambat)
# Rekomendasi production: 12
# -----------------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12
